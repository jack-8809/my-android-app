<?xml version="1.0" encoding="utf-8"?>
<!-- Variant size chip: 1 sqmm / 1.5 sqmm etc. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape android:shape="rectangle">
        <solid android:color="@color/brand_orange_light" />
        <corners android:radius="@dimen/radius_sm" />
        <stroke android:width="1.5dp" android:color="@color/brand_orange" />
    </shape></item>
    <item android:state_checked="true"><shape android:shape="rectangle">
        <solid android:color="@color/brand_orange_light" />
        <corners android:radius="@dimen/radius_sm" />
        <stroke android:width="1.5dp" android:color="@color/brand_orange" />
    </shape></item>
    <item><shape android:shape="rectangle">
        <solid android:color="@color/bg_card" />
        <corners android:radius="@dimen/radius_sm" />
        <stroke android:width="1dp" android:color="@color/stroke_soft" />
    </shape></item>
</selector>
