<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildExpress Design System — Theme + Widget Styles
  REPLACE app/src/main/res/values/styles.xml with this file.

  Existing style names (AppTheme, ModernCard, PremiumButton, CircleImageView,
  TransparentTheme) are all preserved, so your Manifest keeps working.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================================================================
         BASE THEME
         ================================================================== -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorPrimaryVariant">@color/brand_orange_dark</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorSecondary">@color/info_blue</item>
        <item name="colorSecondaryVariant">@color/info_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/brand_orange</item>

        <!-- Surfaces -->
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <!-- System bars: white status bar w/ dark icons reads far more premium
             than a solid orange bar. Requires API 23+, degrades safely. -->
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Global widget defaults -->
        <item name="materialButtonStyle">@style/PremiumButton</item>
        <item name="materialCardViewStyle">@style/ModernCard</item>
        <item name="chipStyle">@style/AppChip</item>
        <item name="bottomSheetDialogTheme">@style/AppBottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/AppAlertDialog</item>
        <item name="textInputStyle">@style/AppTextInput</item>
        <item name="toolbarStyle">@style/AppToolbar</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Shape system -->
        <item name="shapeAppearanceSmallComponent">@style/Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Large</item>

        <!-- Activity transitions -->
        <item name="android:windowAnimationStyle">@style/AppWindowAnimation</item>
    </style>

    <!-- Splash: full-bleed brand, no white flash -->
    <style name="AppTheme.Splash" parent="AppTheme">
        <item name="android:windowBackground">@drawable/bg_brand_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- Full-screen media (zoom image / video) -->
    <style name="AppTheme.Fullscreen" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="TransparentTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/brand_orange</item>
        <item name="colorAccent">@color/brand_orange</item>
    </style>

    <style name="AppWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- ==================================================================
         SHAPES
         ================================================================== -->
    <style name="Shape.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <style name="Shape.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>

    <style name="Shape.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>

    <style name="Shape.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_xl</item>
        <item name="cornerSizeTopRight">@dimen/radius_xl</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ==================================================================
         TYPOGRAPHY  — apply with style="@style/Text.Title"
         ================================================================== -->
    <style name="Text.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.H1" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <!-- Section headers: "Browse Categories", "Browse Materials" -->
    <style name="Text.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:paddingTop">@dimen/space_lg</item>
        <item name="android:paddingBottom">@dimen/space_sm</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.Secondary" parent="Text.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Product name in grid: fixed 2 lines keeps every card the same height -->
    <style name="Text.ProductName" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">normal</item>
        <item name="android:maxLines">2</item>
        <item name="android:minLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Text.Price" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.PriceStruck" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/price_struck</item>
    </style>

    <!-- ==================================================================
         BUTTONS
         ================================================================== -->
    <style name="PremiumButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_xl</item>
        <item name="android:paddingEnd">@dimen/space_xl</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/selector_button_brand</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/brand_orange</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/brand_orange</item>
        <item name="rippleColor">@color/brand_orange_light</item>
    </style>

    <style name="Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_orange</item>
        <item name="rippleColor">@color/brand_orange_light</item>
    </style>

    <!-- Small "Add" button on product cards -->
    <style name="Button.Add" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:minHeight">@dimen/button_height_sm</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_md</item>
        <item name="android:paddingEnd">@dimen/space_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/brand_orange</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/brand_orange</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="rippleColor">@color/brand_orange_light</item>
    </style>

    <style name="Button.Destructive" parent="PremiumButton">
        <item name="backgroundTint">@color/error_red</item>
    </style>

    <!-- ==================================================================
         CARDS
         ================================================================== -->
    <style name="ModernCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/elev_card</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="strokeColor">@color/stroke_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/brand_orange_light</item>
        <item name="android:layout_margin">@dimen/space_sm</item>
    </style>

    <style name="Card.Flat" parent="ModernCard">
        <item name="cardElevation">0dp</item>
        <item name="android:layout_margin">0dp</item>
    </style>

    <style name="Card.Product" parent="ModernCard">
        <item name="cardCornerRadius">@dimen/radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_margin">@dimen/space_xs</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- ==================================================================
         CHIPS / BADGES / PILLS
         ================================================================== -->
    <style name="Badge" />
    <style name="Chip" />

    <style name="AppChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/selector_chip_text</item>
        <item name="chipBackgroundColor">@color/selector_chip_bg</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/brand_orange_light</item>
    </style>

    <!-- Tiny label pill: "Glossy", "Interior", "Shades Available" -->
    <style name="Badge.Tag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill_neutral</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">@dimen/text_micro</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Badge.Discount" parent="Badge.Tag">
        <item name="android:background">@drawable/bg_pill_discount</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Badge.Success" parent="Badge.Tag">
        <item name="android:background">@drawable/bg_pill_success</item>
        <item name="android:textColor">@color/success_green</item>
    </style>

    <style name="Badge.Info" parent="Badge.Tag">
        <item name="android:background">@drawable/bg_pill_info</item>
        <item name="android:textColor">@color/info_blue</item>
    </style>

    <style name="Badge.Warning" parent="Badge.Tag">
        <item name="android:background">@drawable/bg_pill_warning</item>
        <item name="android:textColor">@color/warning_amber</item>
    </style>

    <!-- ==================================================================
         INPUTS
         ================================================================== -->
    <style name="AppTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/selector_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_orange</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="errorTextColor">@color/error_red</item>
        <item name="boxBackgroundColor">@color/bg_card</item>
    </style>

    <!-- ==================================================================
         TOOLBAR / NAV
         ================================================================== -->
    <style name="AppToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/bg_card</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
        <item name="titleTextAppearance">@style/Text.Title</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
    </style>

    <style name="AppBottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/bg_card</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemRippleColor">@color/brand_orange_light</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">@dimen/icon_md</item>
        <item name="elevation">@dimen/elev_sheet</item>
    </style>

    <!-- ==================================================================
         DIALOGS / SHEETS
         ================================================================== -->
    <style name="AppBottomSheetDialog" parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppBottomSheetStyle</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
    </style>

    <style name="AppBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/Shape.TopRounded</item>
        <item name="backgroundTint">@color/bg_card</item>
    </style>

    <style name="AppAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Shape.Large</item>
        <item name="buttonBarPositiveButtonStyle">@style/Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Button.Text</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Text.Title</item>
    </style>

    <!-- ==================================================================
         MISC
         ================================================================== -->
    <style name="AppDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <style name="ScreenRoot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/bg_app</item>
        <item name="android:paddingStart">@dimen/screen_padding_h</item>
        <item name="android:paddingEnd">@dimen/screen_padding_h</item>
    </style>

    <!-- HomeRun-style full-width solid ADD button on product cards -->
    <style name="Button.AddSolid" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/space_sm</item>
        <item name="android:paddingEnd">@dimen/space_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/selector_button_brand</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Amber checkout CTA (HomeRun "Login to checkout") -->
    <style name="Button.Checkout" parent="PremiumButton">
        <item name="backgroundTint">@color/strip_amber</item>
        <item name="android:textColor">@color/strip_amber_text</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <!-- Variant size chip -->
    <style name="Chip.Size">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_size_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
