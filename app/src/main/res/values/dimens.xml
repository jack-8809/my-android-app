<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildExpress Design System — Spacing & Sizing scale.
  NEW FILE: app/src/main/res/values/dimens.xml
  Use these everywhere instead of magic numbers so every screen lines up.
-->
<resources>

    <!-- 4dp base spacing scale -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>
    <dimen name="space_2xl">24dp</dimen>
    <dimen name="space_3xl">32dp</dimen>
    <dimen name="space_4xl">40dp</dimen>

    <!-- Screen gutters: every screen uses this so content aligns app-wide -->
    <dimen name="screen_padding_h">16dp</dimen>
    <dimen name="screen_padding_v">16dp</dimen>
    <dimen name="section_gap">20dp</dimen>

    <!-- Corner radii -->
    <dimen name="radius_xs">6dp</dimen>
    <dimen name="radius_sm">10dp</dimen>
    <dimen name="radius_md">14dp</dimen>
    <dimen name="radius_lg">18dp</dimen>
    <dimen name="radius_xl">24dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- Elevation -->
    <dimen name="elev_none">0dp</dimen>
    <dimen name="elev_card">1dp</dimen>
    <dimen name="elev_raised">3dp</dimen>
    <dimen name="elev_sheet">8dp</dimen>

    <!-- Components -->
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="bottom_nav_height">64dp</dimen>
    <dimen name="button_height">48dp</dimen>
    <dimen name="button_height_sm">36dp</dimen>
    <dimen name="input_height">52dp</dimen>
    <dimen name="touch_min">48dp</dimen>
    <dimen name="icon_sm">18dp</dimen>
    <dimen name="icon_md">24dp</dimen>
    <dimen name="icon_lg">32dp</dimen>
    <dimen name="avatar_md">44dp</dimen>
    <dimen name="avatar_lg">72dp</dimen>

    <!-- Product grid -->
    <dimen name="product_card_image">128dp</dimen>
    <dimen name="product_card_min_width">150dp</dimen>
    <dimen name="cart_thumb">76dp</dimen>
    <dimen name="category_icon">60dp</dimen>
    <dimen name="banner_height">168dp</dimen>

    <!-- Bottom bar clearance so lists never hide behind the CTA/nav -->
    <dimen name="list_bottom_clearance">96dp</dimen>

    <!-- Type scale -->
    <dimen name="text_display">28sp</dimen>
    <dimen name="text_h1">22sp</dimen>
    <dimen name="text_h2">18sp</dimen>
    <dimen name="text_h3">16sp</dimen>
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_body_sm">13sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_micro">11sp</dimen>
</resources>
