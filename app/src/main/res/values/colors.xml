<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildExpress Design System — Colors
  REPLACE app/src/main/res/values/colors.xml

  Palette follows the HomeRun reference structure but recoloured to YOUR
  orange brand. HomeRun's green CTA / yellow checkout become orange here;
  the supporting roles (announcement strip, benefits bar, cashback banner,
  savings green) are kept because they carry meaning, not brand.

  All legacy names retained so nothing breaks.
-->
<resources>

    <!-- ============ BRAND (from your app icon gradient) ============ -->
    <color name="brand_orange">#F26100</color>
    <color name="brand_orange_dark">#C24F00</color>
    <color name="brand_orange_light">#FFF1E3</color>
    <color name="brand_orange_pressed">#A84400</color>
    <color name="brand_gradient_start">#FF9A2E</color>
    <color name="brand_gradient_end">#F26100</color>

    <!-- Announcement strip ("Open 8 am to 8 pm all days") -->
    <color name="strip_amber">#FFC629</color>
    <color name="strip_amber_text">#3D2A00</color>

    <!-- Benefits bar (Pay on Delivery / Cashback / Free Delivery) -->
    <color name="benefit_bar_start">#8C1D18</color>
    <color name="benefit_bar_end">#6E1512</color>
    <color name="benefit_bar_text">#FFFFFF</color>

    <!-- Cashback / rewards banner -->
    <color name="cashback_bg">#0B3D18</color>
    <color name="cashback_track">#1F6B33</color>
    <color name="cashback_fill">#4ADE80</color>
    <color name="cashback_text">#FFFFFF</color>
    <color name="cashback_accent">#FFC629</color>

    <!-- Delivery-speed badge ("60 Mins") -->
    <color name="speed_badge_bg">#0F8A43</color>
    <color name="speed_badge_text">#FFFFFF</color>

    <!-- ============ NEUTRALS / SURFACES ============ -->
