<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_orange"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Explicit Circular Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/profileImgContainer"
        android:layout_width="90dp"
        android:layout_height="90dp"
        app:cardCornerRadius="45dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/bg_card"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/navProfileImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            android:padding="2dp" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/navUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome User"
        android:textColor="@color/bg_card"
        android:textStyle="bold"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/navUserRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer"
        android:textSize="11sp"
        android:textColor="@color/surface_variant" />

    <TextView
        android:id="@+id/navUserRewards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Rewards: 0 pts"
        android:textColor="@color/warning_amber"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
