<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_padding_h"
    android:layout_marginTop="@dimen/space_md"
    android:layout_marginEnd="@dimen/screen_padding_h"
    android:background="@drawable/bg_cashback_banner"
    android:orientation="vertical"
    android:padding="@dimen/space_lg">

    <!-- title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info"
            android:tint="@color/cashback_accent" />

        <TextView
            android:id="@+id/tvCashbackTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:textColor="@color/cashback_text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="Unlock 1% Cashback on ₹100+ orders" />
    </LinearLayout>

    <!-- progress numbers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCashbackProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cashback_text"
            android:textSize="@dimen/text_body_sm"
            android:textStyle="bold"
            tools:text="₹85/₹100" />

        <TextView
            android:id="@+id/tvCashbackRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cashback_accent"
            android:textSize="@dimen/text_body_sm"
            android:textStyle="bold"
            tools:text="Add ₹15 more" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbCashback"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="@dimen/space_sm"
        android:max="100"
        android:progress="85"
        android:progressDrawable="@drawable/bg_progress_track" />

    <TextView
        android:id="@+id/tvCashbackEarned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:alpha="0.9"
        android:gravity="center"
        android:textColor="@color/cashback_text"
        android:textSize="@dimen/text_caption"
        tools:text="You'll earn ₹1 cashback" />
</LinearLayout>
