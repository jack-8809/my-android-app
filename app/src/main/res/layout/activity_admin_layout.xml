<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Homepage Display Settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp" />

        <!-- Shop Status Card -->
        <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Business Status"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange" />

                <Switch
                    android:id="@+id/switchShopOpenStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shop Open (Allow Orders)"
                    android:layout_marginTop="8dp"
                    android:checked="true" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Video Settings -->
        <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promotional Video"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange" />

                <Switch
                    android:id="@+id/switchVideoVisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Video"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvVideoHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Height: 180dp"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekVideoHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="300"
                    android:progress="80" /> <!-- Min 100 + 80 = 180 -->

                <TextView
                    android:id="@+id/tvVideoWidth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Width (Margins): 12dp"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekVideoWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50"
                    android:progress="12" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/surface_variant"
                    android:layout_marginVertical="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Video Content"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnUploadVideo"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Upload"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.AppCompat.Button.Colored"/>

                    <Button
                        android:id="@+id/btnDeleteVideo"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Remove"
                        android:backgroundTint="@color/error_red"
                        android:textColor="@color/bg_card" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Banner Settings -->
        <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Promotional Banners"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange" />

                <Switch
                    android:id="@+id/switchBannerVisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Banners"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvBannerHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Height: 180dp"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBannerHeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="300"
                    android:progress="80" />

                <TextView
                    android:id="@+id/tvBannerWidth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Side Padding: 0dp"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekBannerWidth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50"
                    android:progress="0" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Services Visibility Settings -->
        <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Professional Services Visibility"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange" />

                <Switch
                    android:id="@+id/switchServicesMaster"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Services Section"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/surface_variant"
                    android:layout_marginVertical="8dp" />

                <Switch
                    android:id="@+id/switchShowPlumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Plumber"
                    android:layout_marginTop="4dp" />

                <Switch
                    android:id="@+id/switchShowPainter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Painter &amp; Carpenter"
                    android:layout_marginTop="4dp" />

                <Switch
                    android:id="@+id/switchShowContractor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Contractor"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Delivery Fee Settings -->
        <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Fee Management"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange" />

                <Switch
                    android:id="@+id/switchDeliveryFeeEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Charge Delivery Fee"
                    android:layout_marginTop="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Delivery Amount (₹)"
                    android:layout_marginTop="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputDeliveryFeeAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnPublishLayout"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Publish Changes"
            android:backgroundTint="@color/brand_orange"
            android:textColor="@color/bg_card"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset to Default"
            android:layout_marginTop="8dp"
            style="@style/Widget.AppCompat.Button.Borderless.Colored" />

    </LinearLayout>
</ScrollView>
