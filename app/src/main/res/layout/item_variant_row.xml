<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildExpress — Variant row inside the picker sheet (HomeRun pattern)
  REPLACE app/src/main/res/layout/item_variant_row.xml

  ALL 5 original IDs preserved (used by ItemAdapter, ItemListActivity,
  ItemDetailActivity, CategoryGalleryAdapter):
      ivVariantProduct, tvVariantSize, tvVariantPrice,
      tvVariantOriginalPrice, btnVariantAdd
  -> No Java changes required.

  Matches the screenshot rows: thumbnail · name over struck-MRP + price ·
  green/brand Add button on the right, each row a bordered card.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm">

        <!-- thumbnail -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/bg_subtle"
            app:cardCornerRadius="@dimen/radius_xs"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivVariantProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <!-- name + prices -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVariantSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="Black" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVariantOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:textColor="@color/price_struck"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone"
                    tools:text="₹3811"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvVariantPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_h3"
                    android:textStyle="bold"
                    tools:text="₹1906" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVariantAdd"
            style="@style/Button.AddSolid"
            android:layout_width="86dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_sm"
            android:text="Add" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
