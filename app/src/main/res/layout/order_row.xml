<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:id="@+id/orderIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: ORD-000000"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderCustomerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer: N/A"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/orderItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOrderSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/orderShadeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <View
                android:id="@+id/orderShadePreview"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/circle_white_bg"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvOrderShade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="italic" />
        </LinearLayout>

        <TextView
            android:id="@+id/orderQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/orderPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/success_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/orderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/orderStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Status: Pending"
            android:textColor="@color/brand_orange"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/orderAddressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/adminStatusActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnMarkProgress"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="In Progress"
                android:textSize="12sp"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_marginRight="5dp"/>

            <Button
                android:id="@+id/btnMarkDelivered"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Delivered"
                android:textSize="10sp"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnCancelAdmin"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="CANCEL"
                android:textSize="10sp"
                android:backgroundTint="@color/error_red"
                android:textColor="@color/bg_card"
                style="@style/Widget.AppCompat.Button.Colored" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/downloadViewActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnViewBill"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="View Receipt"
                android:backgroundTint="@color/success_green"
                android:textColor="@color/bg_card"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnCancelOrder"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Cancel Order"
                android:backgroundTint="@color/error_red"
                android:textColor="@color/bg_card"
                style="@style/Widget.AppCompat.Button.Colored"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCancelTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/error_red"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnDownloadBill"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Download Receipt"
                android:backgroundTint="@color/info_blue"
                android:textColor="@color/bg_card"
                style="@style/Widget.AppCompat.Button.Colored"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
