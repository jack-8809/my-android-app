<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_search_bg"
    android:backgroundTint="@color/bg_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item Return Request"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Only items delivered within the last 7 days are eligible."
            android:textSize="12sp"
            android:textColor="@color/error_red"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Order"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinnerEligibleOrders"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_search_bg"
            android:backgroundTint="@color/bg_app"
            android:paddingHorizontal="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Describe the issue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etReturnIssue"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_search_bg"
            android:backgroundTint="@color/bg_app"
            android:gravity="top"
            android:hint="Explain why you want to return the item..."
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Attach Photos"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReturnImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <Button
            android:id="@+id/btnPickReturnImages"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ADD PHOTOS"
            android:textSize="12sp"
            app:strokeColor="@color/brand_orange"
            android:textColor="@color/brand_orange" />

        <Button
            android:id="@+id/btnSubmitReturnRequest"
            style="@style/PremiumButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SUBMIT RETURN REQUEST"
            android:backgroundTint="@color/brand_orange"
            android:textColor="@color/bg_card" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
