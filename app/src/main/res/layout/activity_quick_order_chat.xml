<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_screen_bg">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/success_green"
        android:elevation="4dp"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/chatBackBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/bg_card"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/chatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/chatBackBtn"
            android:text="Quick Order Support"
            android:textColor="@color/bg_card"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnHeaderScan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_policy"
            app:tint="@color/bg_card"
            android:visibility="gone"
            android:contentDescription="Scan New List" />
    </RelativeLayout>

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/confirmOptionsContainer"
        android:layout_below="@id/chatHeader"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Confirm Order Option (The Chained Confirmation buttons) -->
    <LinearLayout
        android:id="@+id/confirmOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/chatInputContainer"
        android:background="@color/bg_card"
        android:padding="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnConfirmOrderSuggestion"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="CONFIRM ORDER"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:backgroundTint="@color/success_green"
            android:textColor="@color/bg_card"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnNeedChangesSuggestion"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="NEED CHANGES"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:backgroundTint="@color/brand_orange"
            android:textColor="@color/bg_card"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Input Area -->
    <LinearLayout
        android:id="@+id/chatInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bg_card"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/chatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/rounded_search_bg"
            android:backgroundTint="@color/chat_screen_bg"
            android:hint="Discuss your order here..."
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:textSize="14sp"
            android:inputType="textCapSentences|textMultiLine" />

        <ImageButton
            android:id="@+id/chatSendBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_white_bg"
            android:backgroundTint="@color/success_green"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/bg_card"
            android:contentDescription="Send" />
    </LinearLayout>

</RelativeLayout>
