<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/white"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Cart Builder"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/graphite_dark" />

        <TextView
            android:id="@+id/tvTargetCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer: Unknown"
            android:textSize="14sp"
            android:textColor="@color/brand_orange_dark"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnAdminAddItems"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ ADD MORE ITEMS"
            android:textColor="@color/info_blue"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminCart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/bottomActions"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="16dp">

        <TextView
            android:id="@+id/tvAdminCartTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Estimate: ₹0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/graphite_dark"
            android:gravity="end"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnShareToChat"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SHARE LIST TO CHAT"
            android:textColor="@color/brand_orange"
            app:strokeColor="@color/brand_orange"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPlaceOrderForUser"
            style="@style/PremiumButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLACE ORDER FOR CUSTOMER"
            android:backgroundTint="@color/success_green"
            android:textColor="@color/white" />
    </LinearLayout>

</RelativeLayout>
