<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <!-- Main Content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:background="@drawable/bg_header_gradient"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <!-- Top Row: Logo and Menu -->
            <RelativeLayout
                android:id="@+id/rlTopHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="BuildExpress"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/menuBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/white" />
            </RelativeLayout>

            <!-- Second Row: Location/Timer Flipper -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rlTopHeader"
                android:layout_marginTop="8dp">

                <ViewFlipper
                    android:id="@+id/headerLocationFlipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoStart="true"
                    android:flipInterval="4000"
                    android:inAnimation="@android:anim/fade_in"
                    android:outAnimation="@android:anim/fade_out">

                    <TextView
                        android:id="@+id/headerLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Deliver at: 000000"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/headerFullAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select your address..."
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <LinearLayout
                        android:id="@+id/headerTimerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_delivery_truck"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/deliveryTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Express Delivery"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:maxLines="1" />
                    </LinearLayout>
                </ViewFlipper>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/adminMainTabs"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    app:tabIndicatorColor="@color/white"
                    app:tabSelectedTextColor="@color/white"
                    app:tabTextColor="#CCFFFFFF"
                    app:tabIndicatorGravity="bottom"
                    android:visibility="gone">
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STOCK" />
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK ORDERS" />
                </com.google.android.material.tabs.TabLayout>

            </RelativeLayout>

            <!-- Floating Search Bar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp">

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/searchView"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        app:queryHint="Search materials, tools..."
                        app:iconifiedByDefault="false"
                        app:searchIcon="@drawable/ic_search"
                        app:closeIcon="@drawable/ic_remove"
                        android:theme="@style/Widget.AppCompat.Light.SearchView" />

                    <ImageButton
                        android:id="@+id/btnVoiceSearch"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_voice_search_premium"
                        android:scaleType="centerInside"
                        android:padding="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerBar"
            android:layout_above="@id/bottomNav">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/fixedTopArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Multi-Image Slider -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/sliderContainer"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_margin="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        android:visibility="gone">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/bannerViewPager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/sliderDots"
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:background="@android:color/transparent"
                            app:tabBackground="@drawable/slider_dot_selector"
                            app:tabGravity="center"
                            app:tabIndicatorHeight="0dp"
                            app:tabMaxWidth="6dp"
                            app:tabMinWidth="6dp"
                            app:tabPaddingStart="2dp"
                            app:tabPaddingEnd="2dp"
                            app:tabRippleColor="@null" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/videoContainer"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_margin="12dp"
                        app:cardBackgroundColor="@color/text_primary"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp">

                        <VideoView
                            android:id="@+id/shopAdvVideo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center" />
                    </androidx.cardview.widget.CardView>

                    <!-- Quick Scan & Order Banner -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvHomeScanOrder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginBottom="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:cardBackgroundColor="@color/success_green_light">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/ic_policy"
                                app:tint="@color/success_green" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Quick Order via Scan"
                                    android:textColor="@color/success_green"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Snap your list &amp; we'll build your cart!"
                                    android:textColor="@color/success_green"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SCAN NOW →"
                                android:textColor="@color/success_green"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Service Quick Access Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Our Services"
                        android:textStyle="bold"
                        android:textColor="@color/graphite_dark"
                        android:textSize="16sp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:id="@+id/servicesRowContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingVertical="12dp"
                        android:layout_marginBottom="8dp">

                        <LinearLayout
                            android:id="@+id/quickPlumber"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_plumber"
                                android:padding="12dp"
                                android:background="@drawable/circle_white_bg"
                                android:elevation="2dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plumber"
                                android:textSize="11sp"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/graphite_medium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickPainter"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_painter"
                                android:padding="12dp"
                                android:background="@drawable/circle_white_bg"
                                android:elevation="2dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Painter"
                                android:textSize="11sp"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/graphite_medium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickContractor"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_contractor"
                                android:padding="12dp"
                                android:background="@drawable/circle_white_bg"
                                android:elevation="2dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contractor"
                                android:textSize="11sp"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/graphite_medium"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/quickCarpenter"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">
                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:src="@drawable/ic_carpenter"
                                android:padding="12dp"
                                android:background="@drawable/circle_white_bg"
                                android:elevation="2dp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carpenter"
                                android:textSize="11sp"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/graphite_medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBrowseCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse by Category"
                    android:textStyle="bold"
                    android:textColor="@color/graphite_dark"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/categoryRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvBrowseMaterials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse Materials"
                    android:textStyle="bold"
                    android:textColor="@color/graphite_dark"
                    android:textSize="16sp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Sorting and Filtering Bar -->
                <LinearLayout
                    android:id="@+id/mainFilterContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <!-- Admin Category Filter Bar (Visible only for Admin/Manager) -->
                    <HorizontalScrollView
                        android:id="@+id/adminCategoryScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/adminCategoryChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            app:singleSelection="true"
                            app:selectionRequired="true" />
                    </HorizontalScrollView>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/mainSortChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/mainChipPopular"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Popular"
                                app:chipIcon="@drawable/ic_info"
                                app:chipIconTint="@color/brand_orange"
                                android:textSize="11sp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/mainChipNewest"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Newest"
                                app:chipIcon="@drawable/ic_add"
                                app:chipIconTint="@color/brand_orange"
                                android:textSize="11sp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/mainChipLowToHigh"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Low to High"
                                app:chipIcon="@drawable/ic_sort_price_up"
                                app:chipIconTint="@color/brand_orange"
                                android:textSize="11sp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/mainChipHighToLow"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="High to Low"
                                app:chipIcon="@drawable/ic_sort_price_down"
                                app:chipIconTint="@color/brand_orange"
                                android:textSize="11sp" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/mainChipPriceFilter"
                                style="@style/Widget.MaterialComponents.Chip.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Filter Price"
                                app:chipIcon="@drawable/ic_filter_tune"
                                app:chipIconTint="@color/brand_orange"
                                android:textSize="11sp" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Price Range Inputs -->
                    <LinearLayout
                        android:id="@+id/mainLlPriceRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/mainEtMinPrice"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_search_bg"
                            android:hint="Min ₹"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:text="-"
                            android:textColor="@color/graphite_medium" />

                        <EditText
                            android:id="@+id/mainEtMaxPrice"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/rounded_search_bg"
                            android:hint="Max ₹"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/mainBtnApplyPriceFilter"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set"
                            android:textColor="@color/brand_orange" />
                    </LinearLayout>
                </LinearLayout>

                <include
                    android:id="@+id/mainShimmerLayout"
                    layout="@layout/shimmer_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAdminQuickOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/brand_orange"
            app:itemTextColor="@color/graphite_dark"
            app:elevation="16dp" />

        <!-- Shop Closed Overlay -->
        <ImageView
            android:id="@+id/imgShopClosedOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerBar"
            android:layout_above="@id/bottomNav"
            android:scaleType="centerInside"
            android:background="@color/bg_card"
            android:src="@drawable/img_shop_closed"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- Floating Action Buttons (Placed at end to be on top) -->
        <FrameLayout
            android:id="@+id/containerQuickChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="80dp"
            android:layout_marginStart="20dp"
            android:clickable="true"
            android:focusable="true">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnOpenQuickChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:src="@android:drawable/ic_menu_send"
                app:backgroundTint="@color/success_green"
                app:tint="@color/white"
                app:elevation="8dp"
                android:contentDescription="Quick Order Chat"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/tvUserUnreadBadge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:minWidth="22dp"
                android:paddingHorizontal="4dp"
                android:layout_gravity="top|end"
                android:background="@drawable/circle_white_bg"
                android:backgroundTint="@color/error_red"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/addFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="80dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            android:contentDescription="Add Item"
            app:backgroundTint="@color/brand_orange"
            app:tint="@color/white"
            app:elevation="8dp" />
    </RelativeLayout>

    <!-- Sidebar Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/brand_orange"
        app:itemTextColor="@color/graphite_dark" />

</androidx.drawerlayout.widget.DrawerLayout>
