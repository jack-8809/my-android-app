<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildExpress — Cart row (REDESIGNED)
  REPLACE app/src/main/res/layout/cart_row.xml

  ALL original IDs preserved:
  imgContainer, cartItemImg, removeCartBtn, detailsContainer, cartItemName,
  tvCartSize, cartShadeContainer, cartShadePreview, tvCartShade, cartItemPrice,
  cartMinusBtn, cartQtyText, cartPlusBtn, tvBulkPrompt
  -> CartAdapter.java needs NO changes.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/screen_padding_h"
    android:layout_marginVertical="@dimen/space_xs"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke_soft"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_md">

        <!-- ===== THUMBNAIL ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imgContainer"
            android:layout_width="@dimen/cart_thumb"
            android:layout_height="@dimen/cart_thumb"
            app:cardBackgroundColor="@color/bg_subtle"
            app:cardCornerRadius="@dimen/radius_sm"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/cartItemImg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="@dimen/space_xs"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== REMOVE ===== -->
        <ImageButton
            android:id="@+id/removeCartBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove item"
            android:padding="@dimen/space_sm"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_tertiary" />

        <!-- ===== DETAILS ===== -->
        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_toStartOf="@id/removeCartBtn"
            android:layout_toEndOf="@id/imgContainer"
            android:minHeight="@dimen/cart_thumb"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cartItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.15"
                tools:text="Asian Paints Royale Luxury Emulsion 4L" />

            <TextView
                android:id="@+id/tvCartSize"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="4 Litre" />

            <!-- Paint shade swatch -->
            <LinearLayout
                android:id="@+id/cartShadeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="@drawable/bg_pill_neutral"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_xs"
                android:paddingTop="3dp"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="3dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/cartShadePreview"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_circle_soft" />

                <TextView
                    android:id="@+id/tvCartShade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_micro"
                    android:textStyle="bold"
                    tools:text="Ivory Cream" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBulkPrompt"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/success_green"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Add 2 more to save ₹40"
                tools:visibility="visible" />

            <!-- Price + stepper on one baseline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cartItemPrice"
                    style="@style/Text.Price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="₹2,472" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height_sm"
                    android:background="@drawable/bg_qty_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/cartMinusBtn"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Decrease quantity"
                        android:padding="8dp"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/brand_orange" />

                    <TextView
                        android:id="@+id/cartQtyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="22dp"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/cartPlusBtn"
                        android:layout_width="34dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Increase quantity"
                        android:padding="8dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/brand_orange" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
