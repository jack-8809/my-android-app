<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bulk Price Update"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/graphite_dark"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Increase or decrease prices across entire categories instantly."
            android:textSize="14sp"
            android:textColor="@color/graphite_medium"
            android:layout_marginBottom="24dp" />

        <androidx.cardview.widget.CardView
            style="@style/ModernCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1: Select Category"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange_dark"
                    android:layout_marginBottom="12dp"/>

                <Spinner
                    android:id="@+id/bulkCategorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/rounded_search_bg"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvSubCatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2: Narrow by Sub-category (Optional)"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange_dark"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

                <Spinner
                    android:id="@+id/bulkSubCategorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/rounded_search_bg"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 3: Enter Percentage Hike/Discount"
                    android:textStyle="bold"
                    android:textColor="@color/brand_orange_dark"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Percentage Value (e.g. 5 or -5)"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:helperText="Use minus (-) for discount">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBulkPercentage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvAffectedCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Items found: Calculating..."
                    android:textColor="@color/graphite_medium"
                    android:textStyle="italic" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnApplyBulkUpdate"
            style="@style/PremiumButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APPLY BULK UPDATE"
            android:backgroundTint="@color/brand_orange"
            android:textColor="@color/white" />

        <ProgressBar
            android:id="@+id/bulkProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
