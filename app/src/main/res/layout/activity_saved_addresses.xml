<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_subtle">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/addressesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/addNewAddressBtn"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/emptyAddressesMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="No saved addresses found"
        android:textColor="@color/text_tertiary"
        android:visibility="gone" />

    <Button
        android:id="@+id/addNewAddressBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="@color/brand_orange"
        android:text="Add New Address"
        android:textColor="@color/bg_card"
        android:textStyle="bold" />

</RelativeLayout>
