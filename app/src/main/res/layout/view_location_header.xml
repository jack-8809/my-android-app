<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildExpress — App header: 60-min badge, deliver-to pincode, search, cart
  NEW FILE: app/src/main/res/layout/view_location_header.xml

  Matches the HomeRun header from your screenshot, adapted to a phone:
  logo · green "60 Mins" badge · Deliver To pincode · wallet · cart
  with the search pill on a second line (full width, like Blinkit/Zepto).

  IDs intentionally match the ones already in activity_item_list.xml so you
  can swap this in with minimal wiring:
    headerLocation, headerFullAddress, searchView, btnVoiceSearch
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding_h"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/screen_padding_h"
    android:paddingBottom="@dimen/space_md">

    <!-- ===== row 1: identity + actions ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="BuildExpress"
            android:src="@mipmap/ic_launcher" />

        <!-- 60 Mins delivery-speed badge -->
        <TextView
            android:id="@+id/tvDeliverySpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:background="@drawable/bg_speed_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="7dp"
            android:paddingTop="5dp"
            android:paddingEnd="7dp"
            android:paddingBottom="5dp"
            android:text="60\nMins"
            android:textColor="@color/speed_badge_text"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Deliver-to -->
        <LinearLayout
            android:id="@+id/headerLocationContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_xs">

            <TextView
                android:id="@+id/headerLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deliver To"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_micro" />

            <TextView
                android:id="@+id/headerFullAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_sort_asc"
                android:drawablePadding="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                tools:text="834001, Ranchi" />
        </LinearLayout>

        <!-- Cart with badge -->
        <FrameLayout
            android:id="@+id/headerCart"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Cart"
                android:src="@drawable/ic_cart"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvCartBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_count"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== row 2: full-width search ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_search_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_sm">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/text_tertiary" />

        <TextView
            android:id="@+id/searchView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Search for Cement"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_body" />

        <ImageButton
            android:id="@+id/btnVoiceSearch"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice search"
            android:padding="7dp"
            android:src="@drawable/ic_search"
            app:tint="@color/brand_orange" />
    </LinearLayout>
</LinearLayout>
