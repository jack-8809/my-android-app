<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProfitOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ORD-12345"
                android:textStyle="bold"
                android:textColor="@color/graphite_dark" />

            <TextView
                android:id="@+id/tvProfitCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:textSize="12sp"
                android:textColor="@color/graphite_medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvProfitAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+₹500"
                android:textColor="@color/success_green"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvProfitTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bill: ₹2500"
                android:textSize="10sp"
                android:textColor="@color/graphite_medium" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
