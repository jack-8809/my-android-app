<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildExpress — Paint product card (REDESIGNED)
  REPLACE app/src/main/res/layout/item_paint_homerun.xml

  ALL original IDs preserved:
  paintImage, tvDiscountBadge, detailsContainer, paintName, paintPrice,
  paintOriginalPrice, tvShadeIndicator, tagFinish, tagArea, tagType,
  paintVariants, btnPaintAdd
  -> PaintColorAdapter / your paint adapter needs NO changes.

  Fixes: the old card locked its inner RelativeLayout to a rigid 360dp with
  absolute-positioned bottom actions, which clipped on small screens. This
  version flows top-to-bottom so it never clips, and lifts 8-11sp text to a
  readable scale.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Card.Product"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_md">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/paintImage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/product_card_image"
                android:background="@drawable/bg_image_placeholder"
                android:contentDescription="@null"
                android:padding="@dimen/space_sm"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_placeholder" />

            <TextView
                android:id="@+id/tvDiscountBadge"
                style="@style/Badge.Discount"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_sm"
                android:visibility="gone"
                tools:text="38% OFF"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvShadeIndicator"
                style="@style/Badge.Info"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/space_sm"
                android:text="Choose colour"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/space_md">

            <TextView
                android:id="@+id/paintName"
                style="@style/Text.ProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Asian Paints Royale Luxury Emulsion" />

            <!-- price + MRP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/paintPrice"
                    style="@style/Text.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="₹618" />

                <TextView
                    android:id="@+id/paintOriginalPrice"
                    style="@style/Text.PriceStruck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone"
                    tools:text="₹810"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- attribute tags -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tagFinish"
                    style="@style/Badge.Tag"
                    tools:text="Glossy" />

                <TextView
                    android:id="@+id/tagArea"
                    style="@style/Badge.Tag"
                    android:layout_marginStart="@dimen/space_xs"
                    tools:text="Interior" />

                <TextView
                    android:id="@+id/tagType"
                    style="@style/Badge.Tag"
                    android:layout_marginStart="@dimen/space_xs"
                    tools:text="Emulsion" />
            </LinearLayout>

            <TextView
                android:id="@+id/paintVariants"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textColor="@color/success_green"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="4 pack sizes available"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaintAdd"
                style="@style/Button.Add"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_sm"
                android:layout_marginTop="@dimen/space_md"
                android:text="Add to cart" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
