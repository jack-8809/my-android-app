<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="380dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/productImageSlider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/sliderIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="12dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="24dp"
                    android:background="@android:color/transparent"
                    app:tabBackground="@drawable/slider_dot_selector"
                    app:tabGravity="center"
                    app:tabIndicatorHeight="0dp"
                    app:tabMaxWidth="10dp"
                    app:tabMinWidth="10dp"
                    app:tabPaddingStart="4dp"
                    app:tabPaddingEnd="4dp"
                    app:tabRippleColor="@null" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/circle_white_bg"
                    android:elevation="4dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/graphite_dark" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@color/white">

                <TextView
                    android:id="@+id/productName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Premium Product"
                    android:textColor="@color/graphite_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/productPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0.00"
                        android:textColor="@color/brand_orange_dark"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" per unit"
                        android:textColor="@color/graphite_medium"
                        android:textSize="14sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Stock"
                    android:textColor="@color/success_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/bulkInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/brand_orange_light"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/bulkInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:text="Bulk Savings: Unlock price at 15 units"
                        android:textColor="@color/brand_orange_dark"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_info"
                        android:drawablePadding="8dp"
                        app:drawableTint="@color/brand_orange_dark" />
                </androidx.cardview.widget.CardView>

                <!-- Select Pack Size Section removed as requested -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/paintShadeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose Your Shade"
                            android:textColor="@color/graphite_dark"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/llManualColorInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilManualColor"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Enter Color Code (e.g. WW 0001)"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp"
                                android:visibility="gone">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etManualColorCode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapCharacters"
                                    android:textSize="14sp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <Button
                                android:id="@+id/btnChooseShade"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Browse"
                                android:textColor="@color/brand_orange"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llSelectedShadeInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:visibility="gone">

                            <View
                                android:id="@+id/selectedColorPreview"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/circle_white_bg" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSelectedShade"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shade Name"
                                    android:textColor="@color/graphite_dark"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvShadeCode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Code"
                                    android:textColor="@color/graphite_medium"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- NEW: Consolidated Product Info Dropdown -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvProductInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/llProductInfoHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center_vertical"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_info"
                                app:tint="@color/brand_orange"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Product Information &amp; Policies"
                                android:textColor="@color/graphite_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cvInfoArrowContainer"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="@color/warning_amber_light">

                                <ImageView
                                    android:id="@+id/ivInfoArrow"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/ic_dropdown_double"
                                    android:rotation="0" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llInfoContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="16dp"
                            android:visibility="gone">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/surface_variant"
                                android:layout_marginBottom="12dp" />

                            <!-- Highlights -->
                            <LinearLayout
                                android:id="@+id/llHighlightsSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Product Highlights"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="@color/brand_orange_dark" />
                                <TextView
                                    android:id="@+id/tvHighlights"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp"
                                    android:textColor="@color/graphite_medium" />
                            </LinearLayout>

                            <!-- Description -->
                            <LinearLayout
                                android:id="@+id/llDescriptionSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Detailed Description"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="@color/brand_orange_dark" />
                                <TextView
                                    android:id="@+id/tvProductDesc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp"
                                    android:textColor="@color/graphite_medium" />
                            </LinearLayout>

                            <!-- Return Policy -->
                            <LinearLayout
                                android:id="@+id/llReturnSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Return Policy"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="@color/brand_orange_dark" />
                                <TextView
                                    android:id="@+id/tvReturnPolicy"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp"
                                    android:textColor="@color/graphite_medium" />
                            </LinearLayout>

                            <!-- Shipping Policy -->
                            <LinearLayout
                                android:id="@+id/llShippingSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shipping Policy"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="@color/brand_orange_dark" />
                                <TextView
                                    android:id="@+id/tvShippingPolicy"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp"
                                    android:textColor="@color/graphite_medium" />
                            </LinearLayout>

                            <!-- Delivery Charges -->
                            <LinearLayout
                                android:id="@+id/llDeliveryChargeSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginBottom="16dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Delivery Charges"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="@color/brand_orange_dark" />
                                <TextView
                                    android:id="@+id/tvDeliveryCharge"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp"
                                    android:textColor="@color/graphite_medium" />
                            </LinearLayout>

                            <!-- Contact Us -->
                            <LinearLayout
                                android:id="@+id/llContactSection"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Contact Us"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="@color/brand_orange_dark" />
                                <TextView
                                    android:id="@+id/tvContactInfo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textSize="14sp"
                                    android:textColor="@color/graphite_medium" />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- tvVariantsLink removed as requested -->

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/rounded_search_bg"
            android:backgroundTint="@color/surface_light"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btnMinus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_remove"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/brand_orange" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/graphite_dark" />

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/brand_orange" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAddToCart"
            style="@style/PremiumButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="@color/brand_orange"
            android:text="Add to Cart"
            android:textColor="@color/white" />
    </LinearLayout>

</RelativeLayout>
