<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImg"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:strokeColor="@color/brand_orange"
            app:strokeWidth="3dp"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to change photo"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/profileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:layout_marginTop="30dp" />

        <EditText
            android:id="@+id/profileMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mobile (+91...)"
            android:inputType="phone"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/profileAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Complete Address"
            android:layout_marginTop="10dp"
            android:lines="3"
            android:gravity="top" />

        <EditText
            android:id="@+id/profilePincode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pincode"
            android:inputType="number"
            android:maxLength="6"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/updateProfileBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Profile"
            android:backgroundTint="@color/brand_orange"
            android:textColor="@color/bg_card"
            android:layout_marginTop="30dp" />

        <Button
            android:id="@+id/manageAddressesBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Saved Addresses"
            android:backgroundTint="@color/info_blue"
            android:textColor="@color/bg_card"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
