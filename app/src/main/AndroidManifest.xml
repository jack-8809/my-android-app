<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".LoginActivity" android:exported="true" />

        <activity android:name=".ItemListActivity" />
        <activity android:name=".AddItemActivity" />
        <activity android:name=".MainActivity" />
        <activity android:name=".RegisterActivity" />
        <activity
            android:name=".OtpVerificationActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="buildexpress-15800.firebaseapp.com" />
            </intent-filter>
        </activity>
        <activity android:name=".MyOrdersActivity" />
        <activity android:name=".AdminOrdersActivity" />
        <activity android:name=".CartActivity" />
        <activity android:name=".TermsActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name=".AdminBannersActivity" />
        <activity android:name=".AdminOrderHistoryActivity" />
        <activity android:name=".ItemDetailActivity" />
        <activity android:name=".ProductDetailActivity" />
        <activity android:name=".AdminLayoutActivity" />
        <activity android:name=".ZoomImageActivity"
            android:theme="@style/AppTheme" />
        <activity android:name=".RewardsActivity" />
        <activity android:name=".ServiceChatActivity" />
        <activity android:name=".AdminChatListActivity" />
        <activity android:name=".AdminServicesActivity" />
        <activity android:name=".ServicesActivity" />
        <activity android:name=".ProfDetailActivity" />
        <activity android:name=".FlashMessageActivity"
            android:theme="@style/TransparentTheme" />
        <activity android:name=".AdminFlashActivity" />
        <activity android:name=".AdminUserListActivity" />
        <activity android:name=".SupportChatActivity" />
        <activity android:name=".AdminSupportListActivity" />
        <activity android:name=".AdminCategoryActivity" />
        <activity android:name=".AdminSubCategoryActivity" />
        <activity android:name=".SubCategoryActivity" />
        <activity android:name=".ResetPasswordActivity" />
        <activity android:name=".SavedAddressesActivity" />
        <activity android:name=".AddAddressActivity" />
        <activity android:name=".PaintColorActivity" />
        <activity android:name=".DetailedProfitActivity" />
        <activity android:name=".AdminDashboardActivity" />
        <activity android:name=".AdminInventoryActivity" />
        <activity android:name=".BulkPriceUpdateActivity" />
        <activity android:name=".ScanOrderActivity" />
        <activity android:name=".AiProcessActivity" />
        <activity android:name=".AdminCartActivity" />
        <activity android:name=".QuickOrderChatActivity" />
        <activity android:name=".AdminQuickOrderListActivity" />

        <service
            android:name=".AdminNotificationService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>
